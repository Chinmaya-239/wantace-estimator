# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (Atlas free tier, Railway, or local mongod)
MONGO_URI=mongodb://127.0.0.1:27017/northline_estimator

# Secret used to sign owner-panel JWTs. Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_string

# How long an owner login session stays valid.
JWT_EXPIRES_IN=12h

# Seed / bootstrap admin credentials (used by src/seed/seed.js).
# Change the password before deploying anywhere public.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=roofing2026!

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your deployed
# frontend URL, plus http://localhost:5173 for local dev).
CORS_ORIGINS=http://localhost:5173
